generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id                    Int       @id @default(autoincrement())
  name                  String
  sellingPricePerTonUSD Float     @default(0)
  products              Product[]
  branchId              Int       @default(1)
  branch                Branch    @relation(fields: [branchId], references: [id])
}

model Product {
  id            Int        @id @default(autoincrement())
  name          String
  type          String?
  thickness     Float?
  width         Float?
  length        Float?
  weightPerUnit    Float?
  quantity         Int        @default(0)
  price            Float
  purchasePriceUSD Float      @default(0)
  transportCostUSD Float      @default(15)
  categoryId       Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  category      Category   @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  returnItems   SaleReturnItem[]
  branchId      Int        @default(1)
  branch        Branch     @relation(fields: [branchId], references: [id])
}

model Sale {
  id              Int        @id @default(autoincrement())
  invoiceNumber   Int?
  customer        String?
  customerId      Int?
  customerRel     Customer?  @relation(fields: [customerId], references: [id])
  total           Float
  paidAmount      Float      @default(0)
  remainingAmount Float      @default(0)
  discount        Float      @default(0)
  status          String     @default("PAID")
  paymentMethod   String     @default("CASH")
  currency        String     @default("SDG")
  currencyRate    Float      @default(1)
  cashAmount      Float      @default(0)
  bankAmount      Float      @default(0)
  chequeAmount    Float      @default(0)
  bankName        String?
  bankRef         String?
  bankTransfers   String?    @db.Text
  bankSender      String?
  bankRecipient   String?
  chequeNumber    String?
  chequeBank      String?
  chequeSender    String?
  chequeRecipient String?
  createdAt       DateTime   @default(now())
  items           SaleItem[]
  payments        Payment[]
  returns         SaleReturn[]
  branchId        Int        @default(1)
  branch          Branch     @relation("InvoiceBranch", fields: [branchId], references: [id])
  dispatchBranchId Int?
  dispatchBranch   Branch?   @relation("DispatchBranch", fields: [dispatchBranchId], references: [id])

  @@unique([branchId, invoiceNumber])
}

model SaleItem {
  id               Int     @id @default(autoincrement())
  saleId           Int
  productId        Int
  quantity         Int
  price            Float
  dispatchBranchId Int?
  dispatchBranch   Branch? @relation("SaleItemDispatchBranch", fields: [dispatchBranchId], references: [id])
  product          Product @relation(fields: [productId], references: [id])
  sale             Sale    @relation(fields: [saleId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int       @id @default(autoincrement())
  description String
  amount      Float
  category    String    @default("تشغيلية")
  date        DateTime  @default(now())
  employeeId  Int?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  branchId    Int        @default(1)
  branch      Branch     @relation(fields: [branchId], references: [id])
}

model Employee {
  id            Int       @id @default(autoincrement())
  name          String
  monthlySalary Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expenses      Expense[]
  branchId      Int        @default(1)
  branch        Branch     @relation(fields: [branchId], references: [id])
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      String    @default("CASHIER")
  createdAt DateTime  @default(now())
  sessions  Session[]
  branchId  Int?
  branch    Branch?   @relation(fields: [branchId], references: [id])
}

model Setting {
  id                 String    @id @default("default")
  companyName        String    @default("اسم الشركة")
  phone              String?
  vatRate            Float     @default(0)
  exchangeRate       Float     @default(0)
  address            String?
  logoUrl            String?   @db.Text
  initialBalance     Float     @default(0)
  initialBalanceDate DateTime?
  initialBalanceRate Float     @default(0)
  fixedMonthlyExpenses Float   @default(0)
  expectedMonthlySupplyTons Float @default(0)
  targetNetProfitMargin Float  @default(0)
  updatedAt          DateTime  @updatedAt
  branchId           Int       @unique @default(1)
  branch             Branch    @relation(fields: [branchId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  branchId  Int      @default(1)
  branch    Branch   @relation(fields: [branchId], references: [id])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Customer {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  company   String?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  branchId  Int               @default(1)
  branch    Branch            @relation(fields: [branchId], references: [id])
  sales     Sale[]
  deposits  CustomerDeposit[]
}

model CustomerDeposit {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String    @default("SDG")
  currencyRate  Float     @default(1)
  paymentMethod String    @default("CASH")
  bankName      String?
  bankRef       String?
  chequeNumber  String?
  chequeBank    String?
  description   String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
  branchId      Int       @default(1)
  branch        Branch    @relation(fields: [branchId], references: [id])
}

model Supplier {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  company   String?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  branchId  Int               @default(1)
  branch    Branch            @relation(fields: [branchId], references: [id])
  purchases Purchase[]
  expenses  Expense[]
  deposits  SupplierDeposit[]
}

model SupplierDeposit {
  id            Int       @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String    @default("USD")
  currencyRate  Float     @default(1)
  paymentMethod String    @default("BANK")
  bankName      String?
  bankRef       String?
  chequeNumber  String?
  chequeBank    String?
  description   String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
  branchId      Int       @default(1)
  branch        Branch    @relation(fields: [branchId], references: [id])
}

model Purchase {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String?
  supplier        String?
  supplierId      Int?
  supplierRel     Supplier?      @relation(fields: [supplierId], references: [id])
  total           Float
  currency        String         @default("SDG")
  currencyRate    Float          @default(1)
  paymentMethod   String         @default("CASH")
  bankName        String?
  bankRef         String?
  chequeNumber    String?
  chequeBank      String?
  depositDeducted Float          @default(0)
  status          String         @default("COMPLETED")
  createdAt       DateTime       @default(now())
  items           PurchaseItem[]
  branchId        Int            @default(1)
  branch          Branch         @relation(fields: [branchId], references: [id])
}

model PurchaseItem {
  id                    Int      @id @default(autoincrement())
  purchaseId            Int
  productId             Int
  quantity              Int
  price                 Float
  purchasePriceCurrency Float?
  sellingPrice          Float?
  product               Product  @relation(fields: [productId], references: [id])
  purchase              Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Branch {
  id                  Int               @id @default(autoincrement())
  name                String            @unique
  code                String            @unique
  address             String?
  phone               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  products            Product[]
  sales               Sale[]            @relation("InvoiceBranch")
  dispatchedSales     Sale[]            @relation("DispatchBranch")
  dispatchedSaleItems SaleItem[]        @relation("SaleItemDispatchBranch")
  expenses            Expense[]
  purchases           Purchase[]
  users               User[]
  categories          Category[]
  settings            Setting[]
  notifications       Notification[]
  employees           Employee[]
  returns             SaleReturn[]
  suppliers           Supplier[]
  customers           Customer[]
  customerDeposits    CustomerDeposit[]
  supplierDeposits    SupplierDeposit[]
}

model SaleReturn {
  id          Int              @id @default(autoincrement())
  returnNumber Int?
  saleId      Int
  sale        Sale             @relation(fields: [saleId], references: [id])
  branchId    Int              @default(1)
  branch      Branch           @relation(fields: [branchId], references: [id])
  totalRefund Float
  reason      String?
  createdAt   DateTime         @default(now())
  items       SaleReturnItem[]
  expenseId   Int?
}

model SaleReturnItem {
  id         Int        @id @default(autoincrement())
  returnId   Int
  productId  Int
  quantity   Int
  unitPrice  Float
  totalPrice Float
  return     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}
